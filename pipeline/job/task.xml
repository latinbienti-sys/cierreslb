      <Command>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -File "C:\Users\yarleyc\cierre-dashboard\run_hourly.ps1"</Arguments>
